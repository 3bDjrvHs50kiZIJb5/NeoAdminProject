@using NeoAdmin.Blazor.Models

@if (Parameters.Count == 0)
{
    <p class="text-sm text-muted-foreground">无参数</p>
}
else
{
    <div class="overflow-x-auto rounded-lg border">
        <table class="w-full text-sm">
            <thead class="bg-muted/50 text-left">
                <tr>
                    <th class="px-3 py-2 font-medium">名称</th>
                    <th class="px-3 py-2 font-medium">位置</th>
                    <th class="px-3 py-2 font-medium">类型</th>
                    <th class="px-3 py-2 font-medium">必须</th>
                    <th class="px-3 py-2 font-medium">说明</th>
                </tr>
            </thead>
            <tbody class="divide-y">
                @foreach (ApiExplorerParameter parameter in Parameters)
                {
                    <tr>
                        <td class="px-3 py-2"><code>@parameter.Name</code></td>
                        <td class="px-3 py-2 text-muted-foreground">@parameter.Source</td>
                        <td class="px-3 py-2 text-muted-foreground">@parameter.Type</td>
                        <td class="px-3 py-2 text-center">
                            @if (parameter.Required)
                            {
                                <span class="text-emerald-600">✓</span>
                            }
                        </td>
                        <td class="px-3 py-2 text-muted-foreground">
                            @(parameter.Description ?? parameter.DefaultValue ?? "—")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<ApiExplorerParameter> Parameters { get; set; } = [];
}
