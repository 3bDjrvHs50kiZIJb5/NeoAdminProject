@page "/admin/ip-whitelist"
@layout LayoutAdmin
@using NeoAdmin.Blazor.Components
@using NeoAdmin.Blazor.Core.Identity
@using NeoAdmin.Blazor.Entities
@using NeoAdmin.Blazor.Services
@using NeoAdmin.Blazor.Utils
@using Microsoft.AspNetCore.Http
@using Microsoft.JSInterop
@inject IFreeSql FreeSql
@inject IHttpContextAccessor HttpContextAccessor
@inject NeoAdminAuthService AuthService
@inject IJSRuntime JSRuntime
@inject MenuPermissionService MenuPermissionService
@inject IToastService ToastService
@inject ILogger<IpWhitelist> Logger

<PageTitle>IP 白名单</PageTitle>

<div class="flex flex-col flex-1 min-h-0 overflow-hidden">
    <CrudTable @ref="table"
               TItem="SysIpWhitelist"
               Title="IP 白名单"
               PageSize="50"
               SearchPlaceholder="IP / 用户.."
               InitQuery="InitQuery"
               OnQuery="HandleQuery"
               OnEdit="HandleEdit"
               OnSaving="HandleSaving"
               OnRemoving="HandleRemoving"
               DialogContentSize="CrudDialogContentSize.Lg">
        <Columns>
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="long"
                             Property="@(row => row.Item.Id)"
                             Header="ID"
                             Sortable="false"
                             Width="180px" />
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="string"
                             Property="@(row => row.Item.IpAddress)"
                             Header="IP"
                             Sortable="false"
                             Width="160px">
                <CellTemplate Context="row">
                    <span class="block truncate font-medium" title="@row.Item.IpAddress">@row.Item.IpAddress</span>
                    @if (!row.Item.IsEnabled && row.Item.UserId is null)
                    {
                        <span class="ml-1 text-xs text-amber-600">待审核</span>
                    }
                </CellTemplate>
            </DataTableColumn>
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="string"
                             Property="@(row => row.Item.User != null ? row.Item.User.Username : string.Empty)"
                             Header="用户"
                             Sortable="false"
                             Width="200px">
                <CellTemplate Context="row">
                    <span class="block truncate" title="@FormatUserLabel(row.Item.User)">@FormatUserLabel(row.Item.User)</span>
                </CellTemplate>
            </DataTableColumn>
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="bool"
                             Property="@(row => row.Item.IsEnabled)"
                             Header="启用"
                             Sortable="false"
                             Width="72px">
                <CellTemplate Context="row">
                    @if (row.Item.IsEnabled)
                    {
                        <span class="text-emerald-600">是</span>
                    }
                    else
                    {
                        <span class="text-red-500">否</span>
                    }
                </CellTemplate>
            </DataTableColumn>
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="string"
                             Property="@(row => row.Item.LastAccessTime.HasValue ? row.Item.LastAccessTime.Value.ToString("yyyy-MM-dd HH:mm:ss") : string.Empty)"
                             Header="最后访问"
                             Sortable="false"
                             Width="160px">
                <CellTemplate Context="row">
                    @(row.Item.LastAccessTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "-")
                </CellTemplate>
            </DataTableColumn>
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="int"
                             Property="@(row => row.Item.AccessCount)"
                             Header="访问次数"
                             Sortable="false"
                             Width="96px" />
            <DataTableColumn TData="CrudGridRow<SysIpWhitelist>"
                             TValue="string"
                             Property="@(_ => string.Empty)"
                             Header="创建时间"
                             Sortable="false"
                             Width="160px">
                <CellTemplate Context="row">
                    @row.Item.CreatedTime.ToString("yyyy-MM-dd HH:mm:ss")
                </CellTemplate>
            </DataTableColumn>
        </Columns>
        <EditTemplate Context="item">
            <div class="space-y-2">
                <Label For="ip-address">IP 地址</Label>
                <Input id="ip-address"
                       Class="w-full"
                       MaxLength="300"
                       Placeholder="如 192.168.1.1"
                       @bind-Value="item.IpAddress" />
            </div>
            <div class="space-y-2">
                <Label For="ip-description">备注</Label>
                <RichTextEditor Id="ip-description"
                                @bind-Value="item.Description"
                                Toolbar="ToolbarPreset.None"
                                MinHeight="96px"
                                Class="w-full" />
            </div>
            <div class="flex items-center gap-2">
                <Checkbox @bind-Checked="item.IsEnabled" Id="ip-enabled" />
                <Label for="ip-enabled">启用</Label>
            </div>
            @if (item.Id > 0)
            {
                <div class="grid gap-3 sm:grid-cols-2 rounded-md border border-border bg-muted/30 p-3 text-sm">
                    <div>
                        <span class="text-muted-foreground">最后访问时间</span>
                        <p class="mt-1 font-medium">
                            @(item.LastAccessTime?.ToString("yyyy-MM-dd HH:mm:ss") ?? "尚未访问")
                        </p>
                    </div>
                    <div>
                        <span class="text-muted-foreground">访问次数</span>
                        <p class="mt-1 font-medium">@item.AccessCount</p>
                    </div>
                </div>
            }
        </EditTemplate>
    </CrudTable>
</div>

@code {
    private CrudTable<SysIpWhitelist> table = default!;
    private bool isAdministrator;

    protected override async Task OnInitializedAsync()
    {
        isAdministrator = await MenuPermissionService.IsAdministratorAsync();
    }

    private Task InitQuery(CrudQueryInfo e)
    {
        e.Filters =
        [
            new CrudFilterInfo("启用", "IsEnabled", false, 4, "是,否", "true,false")
        ];
        return Task.CompletedTask;
    }

    private async Task HandleQuery(CrudQueryEventArgs<SysIpWhitelist> e)
    {
        CrudFilterInfo enabledFilter = e.Filters[0];
        long? currentUserId = await GetCurrentUserIdAsync();
        long userId = currentUserId.GetValueOrDefault();
        isAdministrator = await MenuPermissionService.IsAdministratorAsync();

        e.Select!
            .Include(a => a.User)
            .WhereIf(!isAdministrator && currentUserId.HasValue, a => a.UserId == userId)
            .WhereIf(!isAdministrator && !currentUserId.HasValue, a => false)
            .WhereIf(!string.IsNullOrWhiteSpace(e.SearchText),
                a => a.IpAddress.Contains(e.SearchText!)
                     || a.Description.Contains(e.SearchText!)
                     || a.User.Username.Contains(e.SearchText!)
                     || a.User.Nickname.Contains(e.SearchText!))
            .WhereIf(enabledFilter.HasValue, a => a.IsEnabled == enabledFilter.Value<bool>())
            .OrderByDescending(a => a.Id);
    }

    private async Task HandleEdit(SysIpWhitelist item)
    {
        if (item.Id != 0)
        {
            return;
        }

        item.IsEnabled = true;
        item.AccessCount = 0;

        long? currentUserId = await GetCurrentUserIdAsync();
        if (currentUserId.HasValue && !item.UserId.HasValue)
        {
            item.UserId = currentUserId.Value;
        }

        if (!string.IsNullOrWhiteSpace(item.IpAddress))
        {
            return;
        }

        HttpContext? httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null)
        {
            return;
        }

        string clientIp = IpHelper.GetClientIpAddress(httpContext);
        if (!string.IsNullOrWhiteSpace(clientIp)
            && !string.Equals(clientIp, "unknown", StringComparison.OrdinalIgnoreCase))
        {
            item.IpAddress = clientIp;
        }
    }

    private async Task HandleSaving(CrudConfirmEventArgs<SysIpWhitelist> e)
    {
        SysIpWhitelist item = e.Item;
        long? currentUserId = await GetCurrentUserIdAsync();
        if (!currentUserId.HasValue)
        {
            Logger.LogWarning("保存白名单被拒绝：未登录");
            ToastService.Error("保存失败", "请先登录");
            e.Cancel = true;
            return;
        }

        isAdministrator = await MenuPermissionService.IsAdministratorAsync();
        item.IpAddress = IpHelper.NormalizeIp(item.IpAddress?.Trim());
        item.Description = item.Description?.Trim() ?? string.Empty;

        if (string.IsNullOrWhiteSpace(item.IpAddress) || item.IpAddress == "unknown")
        {
            Logger.LogWarning("保存白名单被拒绝：IP 无效，UserId={UserId}", currentUserId.Value);
            ToastService.Error("保存失败", "请填写有效的 IP 地址");
            e.Cancel = true;
            return;
        }

        if (item.Id == 0 || !isAdministrator)
        {
            item.UserId = currentUserId.Value;
        }

        if (item.Id > 0)
        {
            SysIpWhitelist? existing = await FreeSql.Select<SysIpWhitelist>()
                .Where(a => a.Id == item.Id)
                .FirstAsync();
            if (existing is null)
            {
                Logger.LogWarning("保存白名单被拒绝：记录不存在，Id={Id}", item.Id);
                ToastService.Error("保存失败", "记录不存在");
                e.Cancel = true;
                return;
            }

            if (!isAdministrator && existing.UserId != currentUserId.Value)
            {
                Logger.LogWarning("保存白名单被拒绝：无权修改他人记录，Id={Id}，UserId={UserId}", item.Id, currentUserId.Value);
                ToastService.Error("保存失败", "只能修改自己的白名单");
                e.Cancel = true;
                return;
            }
        }

        bool ipExists = await FreeSql.Select<SysIpWhitelist>()
            .Where(a => a.UserId == item.UserId && a.IpAddress == item.IpAddress && a.Id != item.Id)
            .AnyAsync();

        if (ipExists)
        {
            Logger.LogWarning("保存白名单被拒绝：IP 已存在，UserId={UserId}，Ip={Ip}", item.UserId, item.IpAddress);
            ToastService.Error("保存失败", "该用户已存在相同 IP");
            e.Cancel = true;
            return;
        }

        if (item.Id == 0)
        {
            item.CreatedTime = DateTime.Now;
            item.AccessCount = 0;
            item.LastAccessTime = null;
            Logger.LogInformation("新增白名单，UserId={UserId}，Ip={Ip}", item.UserId, item.IpAddress);
        }
        else
        {
            Logger.LogInformation("更新白名单，Id={Id}，UserId={UserId}，Ip={Ip}", item.Id, item.UserId, item.IpAddress);
        }
    }

    private async Task HandleRemoving(CrudConfirmEventArgs<SysIpWhitelist> e)
    {
        if (isAdministrator)
        {
            Logger.LogInformation("删除白名单，Id={Id}，UserId={UserId}，Ip={Ip}", e.Item.Id, e.Item.UserId, e.Item.IpAddress);
            return;
        }

        long? currentUserId = await GetCurrentUserIdAsync();
        SysIpWhitelist? existing = await FreeSql.Select<SysIpWhitelist>()
            .Where(a => a.Id == e.Item.Id)
            .FirstAsync();

        if (existing is null)
        {
            Logger.LogWarning("删除白名单被拒绝：记录不存在，Id={Id}", e.Item.Id);
            ToastService.Error("删除失败", "记录不存在");
            e.Cancel = true;
            return;
        }

        if (!currentUserId.HasValue || existing.UserId != currentUserId.Value)
        {
            Logger.LogWarning("删除白名单被拒绝：无权删除他人记录，Id={Id}", e.Item.Id);
            ToastService.Error("删除失败", "只能删除自己的白名单");
            e.Cancel = true;
            return;
        }

        Logger.LogInformation("删除白名单，Id={Id}，UserId={UserId}，Ip={Ip}", existing.Id, existing.UserId, existing.IpAddress);
    }

    private static string FormatUserLabel(SysUser? user)
    {
        if (user is null)
        {
            return "未关联";
        }

        if (string.IsNullOrWhiteSpace(user.Nickname) || string.Equals(user.Nickname, user.Username, StringComparison.Ordinal))
        {
            return user.Username;
        }

        return $"{user.Username}（{user.Nickname}）";
    }

    private async Task<long?> GetCurrentUserIdAsync()
    {
        string? token = HttpContextAccessor.HttpContext?.Request.Headers.Authorization.FirstOrDefault();
        if (!string.IsNullOrWhiteSpace(token)
            && token.StartsWith("Bearer ", StringComparison.OrdinalIgnoreCase))
        {
            token = token[7..].Trim();
        }
        else
        {
            try
            {
                token = await JSRuntime.InvokeAsync<string?>("neoAdminAuth.getToken");
            }
            catch (InvalidOperationException)
            {
                // 非 Blazor 交互上下文时忽略。
            }
            catch (JSException)
            {
                // JS 未就绪时忽略。
            }
        }

        if (string.IsNullOrWhiteSpace(token))
        {
            return null;
        }

        ApiResult<UserSummaryResponse> result = await AuthService.CheckAsync(token);
        return result.Succeeded ? result.Data!.Id : null;
    }
}
