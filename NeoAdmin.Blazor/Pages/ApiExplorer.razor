@page "/admin/api-explorer"
@layout LayoutAdmin
@using System.Text.Json
@using NeoAdmin.Blazor.Components.ApiExplorer
@using NeoAdmin.Blazor.Models
@using NeoAdmin.Blazor.Services
@inject ApiExplorerCatalogService CatalogService
@inject IJSRuntime JSRuntime
@inject ILogger<ApiExplorer> Logger

<PageTitle>API 调试</PageTitle>

@* Tailwind 扫描用：HTTP method badge 完整类名 *@
<div class="hidden" aria-hidden="true">
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-emerald-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-blue-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-amber-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-orange-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-rose-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
    <span class="inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-slate-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"></span>
</div>

<div class="neo-admin-page-scroll flex min-h-0 flex-1 flex-col p-1">
    <div class="flex min-h-0 flex-1 overflow-hidden rounded-xl border bg-card shadow-sm">
        <aside class="flex w-72 shrink-0 flex-col border-r bg-background">
            <div class="border-b px-4 py-3">
                <div class="text-sm font-semibold leading-snug">API 调试</div>
                <div class="mt-1 text-xs text-muted-foreground">扫描已注册 Controller（含宿主）</div>
            </div>

            <div class="space-y-2 border-b px-3 py-2">
                <Input @bind-Value="searchKeyword"
                       Placeholder="搜索接口…"
                       Class="h-8 text-xs" />
                @if (assemblyOptions.Count > 0)
                {
                    <NativeSelect TValue="string"
                                  Class="h-8 w-full text-xs"
                                  Value="@selectedAssembly"
                                  ValueChanged="OnAssemblyChanged">
                        <NativeSelectOption Value="@AllAssembliesValue">全部程序集 (@endpoints.Count)</NativeSelectOption>
                        @foreach (string assembly in assemblyOptions)
                        {
                            int count = endpoints.Count(e =>
                                string.Equals(e.SourceAssembly, assembly, StringComparison.OrdinalIgnoreCase));
                            <NativeSelectOption Value="@assembly">@assembly (@count)</NativeSelectOption>
                        }
                    </NativeSelect>
                }
            </div>

            <div class="min-h-0 flex-1 overflow-y-auto py-2">
                @if (endpoints.Count == 0)
                {
                    <div class="px-3 py-4 text-xs text-muted-foreground">未发现 api/* 接口</div>
                }
                else if (!FilteredGroups.Any())
                {
                    <div class="px-3 py-4 text-xs text-muted-foreground">当前筛选条件下无匹配接口</div>
                }
                else
                {
                    @foreach (IGrouping<string, ApiExplorerEndpoint> group in FilteredGroups)
                    {
                        bool expanded = IsGroupExpanded(group.Key);
                        <button type="button"
                                class="flex w-full items-center gap-1.5 px-3 pb-1 pt-2 text-left text-xs font-medium text-muted-foreground hover:text-foreground"
                                @onclick="() => ToggleGroup(group.Key)"
                                aria-expanded="@expanded">
                            <LucideIcon Name="@(expanded ? "chevron-down" : "chevron-right")" Size="12" Class="shrink-0 opacity-70" />
                            <span class="truncate">@group.Key</span>
                            <span class="ml-auto tabular-nums opacity-60">@group.Count()</span>
                        </button>
                        @if (expanded)
                        {
                            @foreach (ApiExplorerEndpoint endpoint in group)
                            {
                                <button type="button"
                                        class="@GetSidebarItemClass(endpoint.Id)"
                                        @onclick="() => SelectEndpoint(endpoint.Id)">
                                    <span class="@GetMethodBadgeClass(endpoint.HttpMethod)">@endpoint.HttpMethod</span>
                                    <span class="truncate">@endpoint.Title</span>
                                </button>
                            }
                        }
                    }
                }
            </div>
        </aside>

        <main class="min-w-0 flex-1 overflow-y-auto">
            @if (selectedEndpoint is null)
            {
                <div class="flex h-full items-center justify-center text-sm text-muted-foreground">
                    请从左侧选择一个接口
                </div>
            }
            else
            {
                <div class="border-b px-6 py-5">
                    <h1 class="text-2xl font-semibold tracking-tight">@selectedEndpoint.Title</h1>
                    <p class="mt-2 text-sm text-muted-foreground">
                        @(selectedEndpoint.ControllerName)
                        @if (!string.IsNullOrWhiteSpace(selectedEndpoint.RequestBodyTypeName))
                        {
                            <span> · Body: @selectedEndpoint.RequestBodyTypeName</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(selectedEndpoint.ResponseTypeName))
                        {
                            <span> · Response: @selectedEndpoint.ResponseTypeName</span>
                        }
                    </p>
                </div>

                <div class="border-b bg-slate-800 px-6 py-3 text-white"
                     style="--selection: rgb(125 211 252); --selection-foreground: rgb(15 23 42);">
                    <div class="flex items-center gap-3">
                        <span class="@GetMethodBadgeClass(selectedEndpoint.HttpMethod)">@selectedEndpoint.HttpMethod</span>
                        <code class="text-sm font-mono text-slate-100">/@selectedEndpoint.RelativePath</code>
                        <button type="button"
                                class="ml-auto inline-flex size-8 items-center justify-center rounded-md text-slate-300 transition-colors hover:bg-slate-700 hover:text-white"
                                @onclick='() => CopyTextAsync("/" + selectedEndpoint.RelativePath)'
                                aria-label="复制接口地址">
                            <LucideIcon Name="copy" Size="14" />
                        </button>
                    </div>
                </div>

                <div class="px-6 py-4">
                    <Tabs Value="@detailTab" ValueChanged="OnDetailTabChanged" Class="w-full">
                        <TabsList Class="h-9">
                            <TabsTrigger Value="tryit">在线测试</TabsTrigger>
                            <TabsTrigger Value="doc">参数</TabsTrigger>
                            <TabsTrigger Value="intro">简介</TabsTrigger>
                        </TabsList>

                        <TabsContent Value="tryit" Class="mt-4">
                            <ApiExplorerTryIt Endpoint="selectedEndpoint" />
                        </TabsContent>

                        <TabsContent Value="doc" Class="mt-4 space-y-4">
                            <section>
                                <h2 class="mb-3 text-sm font-semibold">请求参数</h2>
                                <ApiExplorerParamTable Parameters="selectedEndpoint.Parameters" />
                            </section>
                        </TabsContent>

                        <TabsContent Value="intro" Class="mt-4 space-y-4">
                            <div class="space-y-2 text-sm leading-relaxed">
                                @if (selectedEndpoint.AllowAnonymous)
                                {
                                    <Badge Variant="BadgeVariant.Secondary">无需登录</Badge>
                                }
                                <p>
                                    @(string.IsNullOrWhiteSpace(selectedEndpoint.Summary)
                                        ? $"{selectedEndpoint.HttpMethod} /{selectedEndpoint.RelativePath}"
                                        : selectedEndpoint.Summary)
                                </p>
                                @if (!string.IsNullOrWhiteSpace(selectedEndpoint.Remarks))
                                {
                                    <p class="text-muted-foreground">@selectedEndpoint.Remarks</p>
                                }
                            </div>
                            <section>
                                <h2 class="mb-2 text-sm font-semibold">调用示例</h2>
                                <pre class="overflow-x-auto rounded-lg border bg-muted/40 p-4 text-xs leading-relaxed"><code>@ApiExplorerDocumentation.BuildExample(selectedEndpoint)</code></pre>
                            </section>
                        </TabsContent>
                    </Tabs>
                </div>
            }
        </main>
    </div>
</div>

@code {
    private const string CollapsedGroupsStorageKey = "neoadmin:api-explorer:collapsed-groups";
    private const string AllAssembliesValue = "*";

    private readonly HashSet<string> collapsedGroups = new(StringComparer.OrdinalIgnoreCase);

    private IReadOnlyList<ApiExplorerEndpoint> endpoints = [];
    private string searchKeyword = string.Empty;
    private string selectedAssembly = AllAssembliesValue;
    private string selectedEndpointId = string.Empty;
    private string detailTab = "tryit";
    private bool collapsedStateLoaded;

    private ApiExplorerEndpoint? selectedEndpoint =>
        endpoints.FirstOrDefault(e => string.Equals(e.Id, selectedEndpointId, StringComparison.OrdinalIgnoreCase));

    private IReadOnlyList<string> assemblyOptions =>
        endpoints
            .Select(e => e.SourceAssembly)
            .Where(a => !string.IsNullOrWhiteSpace(a))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(a => a, StringComparer.OrdinalIgnoreCase)
            .Cast<string>()
            .ToList();

    private IEnumerable<ApiExplorerEndpoint> VisibleEndpoints
    {
        get
        {
            if (string.Equals(selectedAssembly, AllAssembliesValue, StringComparison.Ordinal))
            {
                return endpoints;
            }

            return endpoints.Where(e =>
                string.Equals(e.SourceAssembly, selectedAssembly, StringComparison.OrdinalIgnoreCase));
        }
    }

    private IEnumerable<IGrouping<string, ApiExplorerEndpoint>> FilteredGroups
    {
        get
        {
            IEnumerable<ApiExplorerEndpoint> filtered = VisibleEndpoints;
            if (!string.IsNullOrWhiteSpace(searchKeyword))
            {
                filtered = filtered.Where(e =>
                    e.Title.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                    || e.RelativePath.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                    || e.HttpMethod.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase)
                    || e.Group.Contains(searchKeyword, StringComparison.OrdinalIgnoreCase));
            }

            return filtered.GroupBy(e => e.Group);
        }
    }

    protected override void OnInitialized()
    {
        Logger.LogInformation("进入 API 调试页");
        endpoints = CatalogService.GetEndpoints();
        if (endpoints.Count > 0 && string.IsNullOrWhiteSpace(selectedEndpointId))
        {
            selectedEndpointId = endpoints[0].Id;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || collapsedStateLoaded)
        {
            return;
        }

        collapsedStateLoaded = true;
        await LoadCollapsedGroupsAsync();
        StateHasChanged();
    }

    private bool IsGroupExpanded(string groupKey)
    {
        // 搜索时强制展开，便于查看匹配结果
        if (!string.IsNullOrWhiteSpace(searchKeyword))
        {
            return true;
        }

        return !collapsedGroups.Contains(groupKey);
    }

    private async Task ToggleGroup(string groupKey)
    {
        if (!collapsedGroups.Remove(groupKey))
        {
            collapsedGroups.Add(groupKey);
        }

        await SaveCollapsedGroupsAsync();
    }

    private async Task LoadCollapsedGroupsAsync()
    {
        try
        {
            string? json = await JSRuntime.InvokeAsync<string?>("localStorage.getItem", CollapsedGroupsStorageKey);
            if (string.IsNullOrWhiteSpace(json))
            {
                return;
            }

            string[]? groups = JsonSerializer.Deserialize<string[]>(json);
            if (groups is null || groups.Length == 0)
            {
                return;
            }

            collapsedGroups.Clear();
            foreach (string group in groups)
            {
                if (!string.IsNullOrWhiteSpace(group))
                {
                    collapsedGroups.Add(group);
                }
            }
        }
        catch (Exception ex) when (ex is JSException or JsonException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "读取 API 调试分组折叠状态失败");
        }
    }

    private async Task SaveCollapsedGroupsAsync()
    {
        try
        {
            string json = JsonSerializer.Serialize(collapsedGroups.OrderBy(g => g, StringComparer.OrdinalIgnoreCase).ToArray());
            await JSRuntime.InvokeVoidAsync("localStorage.setItem", CollapsedGroupsStorageKey, json);
        }
        catch (Exception ex) when (ex is JSException or InvalidOperationException)
        {
            Logger.LogDebug(ex, "保存 API 调试分组折叠状态失败");
        }
    }

    private void SelectEndpoint(string id)
    {
        selectedEndpointId = id;
        detailTab = "tryit";
    }

    private void OnAssemblyChanged(string value)
    {
        selectedAssembly = value;
        EnsureSelectedEndpointVisible();
        Logger.LogInformation("API 调试切换程序集，Assembly={Assembly}", value);
    }

    private void EnsureSelectedEndpointVisible()
    {
        List<ApiExplorerEndpoint> visible = VisibleEndpoints.ToList();
        if (visible.Count == 0)
        {
            selectedEndpointId = string.Empty;
            return;
        }

        if (!visible.Any(e => string.Equals(e.Id, selectedEndpointId, StringComparison.OrdinalIgnoreCase)))
        {
            selectedEndpointId = visible[0].Id;
        }
    }

    private Task OnDetailTabChanged(string value)
    {
        detailTab = value;
        return Task.CompletedTask;
    }

    private string GetSidebarItemClass(string endpointId)
    {
        bool active = string.Equals(endpointId, selectedEndpointId, StringComparison.OrdinalIgnoreCase);
        return active
            ? "flex w-full items-center gap-2 truncate rounded-md bg-accent px-3 py-2 text-left text-xs text-accent-foreground"
            : "flex w-full items-center gap-2 truncate rounded-md px-3 py-2 text-left text-xs text-muted-foreground hover:bg-accent/60 hover:text-accent-foreground";
    }

    private static string GetMethodBadgeClass(string method)
    {
        return method.ToUpperInvariant() switch
        {
            "GET" => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-emerald-500 px-1.5 py-0.5 text-[10px] font-semibold text-white",
            "POST" => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-blue-500 px-1.5 py-0.5 text-[10px] font-semibold text-white",
            "PUT" => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-amber-500 px-1.5 py-0.5 text-[10px] font-semibold text-white",
            "PATCH" => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-orange-500 px-1.5 py-0.5 text-[10px] font-semibold text-white",
            "DELETE" => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-rose-500 px-1.5 py-0.5 text-[10px] font-semibold text-white",
            _ => "inline-flex min-w-10 shrink-0 items-center justify-center rounded bg-slate-500 px-1.5 py-0.5 text-[10px] font-semibold text-white"
        };
    }

    private async Task CopyTextAsync(string text)
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", text);
        }
        catch (JSException ex)
        {
            Logger.LogWarning(ex, "复制失败");
        }
    }
}
